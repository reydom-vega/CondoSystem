# Copy to .env on the server. Environment variables override .env.
# Keep real credentials out of git and out of the public document root when
# hosting offers a private configuration directory. Apache denies .env URLs.

CONDO_APP_ENV=local
CONDO_APP_URL=http://localhost/CondoSystem3
CONDO_AUTO_MIGRATE=1

# Production: set APP_ENV=production, an HTTPS APP_URL and AUTO_MIGRATE=0.
# Use a dedicated database account instead of root. Never reuse these examples.
# Hosting Configuration

CONDO_DB_HOST=localhost
CONDO_DB_USER=root
CONDO_DB_PASS=
CONDO_DB_NAME=Condo_System

# Email Configuration

CONDO_SMTP_HOST=smtp.gmail.com
CONDO_SMTP_PORT=587
CONDO_SMTP_SECURE=tls
CONDO_SMTP_USER=
CONDO_SMTP_PASS=
CONDO_MAIL_FROM=
CONDO_MAIL_FROM_NAME=The Celandine Homes

# Use a persistent random 64-character hex key. Rotating it revokes old QR codes.
# Optional locally: migration creates a persisted key in access_signing_keys.
CONDO_PASS_SIGNING_KEY=

# Supply new provider credentials. Old values in source/history must be revoked.
# Paymongo Configuration
CONDO_PAYMONGO_SECRET_KEY=
CONDO_PAYMONGO_WEBHOOK_SECRET=
CONDO_PAYMONGO_METHODS=card,gcash,paymaya,dob

# HTTP reminders require POST Authorization: Bearer <secret>; CLI needs no token.
# SMS configuration

CONDO_CRON_SECRET=
CONDO_SMS_PROVIDER=semaphore
CONDO_SEMAPHORE_API_KEY=
CONDO_SEMAPHORE_SENDER_NAME=The Celandine Homes
CONDO_TWILIO_SID=
CONDO_TWILIO_AUTH_TOKEN=
CONDO_TWILIO_FROM=
