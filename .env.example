# Copy to .env on the server. Environment variables override .env.
# Keep real credentials out of git and out of the public document root when
# hosting offers a private configuration directory. Apache denies .env URLs.

CONDO_APP_ENV=local
CONDO_APP_URL=http://localhost/CondoSystem3
CONDO_AUTO_MIGRATE=1

# Production: set APP_ENV=production, an HTTPS APP_URL and AUTO_MIGRATE=0.
# Use a dedicated database account instead of root. Never reuse these examples.
# Hosting Configuration

CONDO_DB_HOST=localhost
CONDO_DB_USER=root
CONDO_DB_PASS=
CONDO_DB_NAME=Condo_System

# Email Configuration

CONDO_SMTP_HOST=smtp.gmail.com
CONDO_SMTP_PORT=587
CONDO_SMTP_SECURE=tls
CONDO_SMTP_USER=
CONDO_SMTP_PASS=
CONDO_MAIL_FROM=
CONDO_MAIL_FROM_NAME=The Celandine

# Community reports: property-manager reviewers explicitly designated by user ID.
# An accused/conflicted account is always excluded, including a Super Admin.
CONDO_REPORT_INDEPENDENT_REVIEWER_IDS=
# Absolute folder outside the document root; blank uses sibling private storage.
CONDO_REPORT_STORAGE=
CONDO_REPORT_MAX_FILES=5
CONDO_REPORT_MAX_FILE_MB=10
CONDO_REPORT_MAX_TOTAL_MB=30
CONDO_REPORT_ANONYMOUS_ACCESS_DAYS=365
CONDO_REPORT_EVIDENCE_RETENTION_DAYS=365
# Optional JSON array of category labels. Other is always available.
CONDO_REPORT_CATEGORIES=[]
# Optional persistent 64-character hex signing key; migration otherwise stores one.
CONDO_REPORT_AUDIT_KEY=

# Use a persistent random 64-character hex key. Rotating it revokes old QR codes.
# Optional locally: migration creates a persisted key in access_signing_keys.
CONDO_PASS_SIGNING_KEY=

# Absolute folder OUTSIDE the web/document root. Blank uses a sibling of htdocs.
# On hosted servers set a private home-directory path writable by PHP.
CONDO_VISITOR_ID_STORAGE=
# Delete ID images and optional number references after this many full days
# following the visit date. Run scripts/purge_visitor_ids.php --apply daily.
CONDO_VISITOR_ID_RETENTION_DAYS=30

# Supply new provider credentials. Old values in source/history must be revoked.
# Paymongo Configuration
CONDO_PAYMONGO_SECRET_KEY=
CONDO_PAYMONGO_WEBHOOK_SECRET=
CONDO_PAYMONGO_METHODS=card,gcash,paymaya,dob

# HTTP reminders require POST Authorization: Bearer <secret>; CLI needs no token.
# SMS configuration

CONDO_CRON_SECRET=
CONDO_SMS_PROVIDER=semaphore
CONDO_SEMAPHORE_API_KEY=
CONDO_SEMAPHORE_SENDER_NAME=The Celandine Homes
CONDO_TWILIO_SID=
CONDO_TWILIO_AUTH_TOKEN=
CONDO_TWILIO_FROM=

# Allow approved tenants and authorized occupants to submit permits for management review.
CONDO_TENANT_PERMITS=1
# Enable only after PMO authorizes billing a verified resident for visitor vehicle incidents.
CONDO_VISITOR_VIOLATION_HOST_BILLING=0

# Optional maximum size of each property permit document (1-20 MB).
CONDO_PERMIT_UPLOAD_MAX_MB=5

# Explicit cap for complete staff report snapshots/exports. Live history remains paginated.
CONDO_JOB_REPORT_MAX_ACTIVITIES=2000
