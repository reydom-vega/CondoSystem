# Deployment secrets stay outside source control.
.env
.env.*
!.env.example
config.local.php
*.log
*.sql
!/database.sql
!/migrations/2026_10_11_vehicle_violations.sql
!/migrations/2026_10_13_digital_id.sql
!/migrations/2026_10_14_profile_photos.sql
!/migrations/2026_10_14_community_reports.sql
!/migrations/2026_10_14_visitor_parking.sql
!/migrations/2026_10_14_job_reports.sql
*.bak
*.zip

# Local tooling/dependencies can be installed from composer.lock.
/.venv/
/vendor/*
!/vendor/.htaccess

# Private resident/staff documents are data, not source artifacts.
/private_uploads/**
!/private_uploads/**/
!/private_uploads/**/.htaccess
